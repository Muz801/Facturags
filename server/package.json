    "express": "^4.19.2",
    "fast-xml-parser": "^5.10.1",
    "haciendacostarica-signer": "^1.0.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "node-forge": "^1.4.0",
    "nodemailer": "^6.9.14",
    "qrcode": "^1.5.4",
    "uuid": "^10.0.0",
    "xmlbuilder2": "^3.1.1",
    "xpath": "^0.0.34"
