  "description": "Backend Express + MySQL para FacturaPOS - Punto de venta y facturacion electronica Costa Rica v4.4",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node scripts/migrate.js",
    "migrate:fiscal": "node scripts/migrate-fiscal.js",
