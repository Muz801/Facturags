# ============================================================
#  FacturaPOS - Variables de entorno del SERVIDOR (Express)
#  Copia este archivo a ".env" y completa los valores.
# ============================================================

# --- Entorno ---
NODE_ENV=development
PORT=4000

# URL del frontend (para CORS). En produccion pon tu dominio de Netlify.
CLIENT_URL=http://localhost:3000

# --- Base de datos MySQL ---
# En local puedes usar XAMPP / MySQL local.
# En produccion: usa el connection string que te da Render / PlanetScale / Railway.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=facturapos
# Si tu proveedor exige SSL (PlanetScale, Aiven, etc.), pon true:
DB_SSL=false

# --- Seguridad ---
# Secreto para firmar los JWT de login. Cambia esto por una cadena larga y aleatoria.
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria_1234567890
JWT_EXPIRES_IN=7d

# Clave de cifrado AES-256 para los secretos de Hacienda guardados en BD
# (PIN de la llave, contrasena de API). DEBE tener exactamente 32 caracteres.
ENCRYPTION_KEY=clave_de_32_caracteres_exactos!!

# --- Correo (envio de tiquetes / facturas por email) ---
# Usa un SMTP real (Gmail con clave de aplicacion, SendGrid, Mailgun, etc.)
# Si lo dejas vacio, el sistema simula el envio y lo muestra en consola (modo demo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FacturaPOS <no-reply@tudominio.com>

# --- Hacienda (Factura Electronica CR v4.4) ---
# Estos son los endpoints OFICIALES de Hacienda. Normalmente NO se cambian.
# El ambiente (sandbox/produccion) y las credenciales de cada negocio
# se configuran DESDE LA APP (Configuracion -> Factura Electronica), no aqui.
HACIENDA_SANDBOX_TOKEN_URL=https://idp.comprobanteselectronicos.go.cr/auth/realms/rut-stag/protocol/openid-connect/token
HACIENDA_SANDBOX_RECEPCION_URL=https://api.comprobanteselectronicos.go.cr/recepcion-sandbox/v1/
HACIENDA_PROD_TOKEN_URL=https://idp.comprobanteselectronicos.go.cr/auth/realms/rut/protocol/openid-connect/token
HACIENDA_PROD_RECEPCION_URL=https://api.comprobanteselectronicos.go.cr/recepcion/v1/
HACIENDA_SANDBOX_CLIENT_ID=api-stag
HACIENDA_PROD_CLIENT_ID=api-prod
